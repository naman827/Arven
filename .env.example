# Copy this file to .env (same folder) and fill in your keys. Never commit .env.
# The app runs with any subset of keys; missing ones show as "not configured" in Settings.

# --- Model providers (Gemini is primary; NVIDIA is the automatic fallback) ---
GEMINI_API_KEY=
# Leave empty to use the default (gemini-3.5-flash-lite). Example alternative: gemini-3.8-flash
GEMINI_MODEL=
NVIDIA_API_KEY=
NVIDIA_MODEL=meta/llama-3.3-70b-instruct
NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1

# --- Web search (needed for Research and Deep Research) ---
TAVILY_API_KEY=
SEARCH_PROVIDER=tavily
# Best-effort DuckDuckGo fallback when Tavily fails (unofficial, rate-limited)
ENABLE_DUCKDUCKGO_FALLBACK=true

# --- Storage ---
DATABASE_URL=sqlite:///./data/arven_ai.db

# --- Server (local only) ---
BACKEND_HOST=127.0.0.1
BACKEND_PORT=8000
FRONTEND_ORIGIN=http://localhost:5173

# --- Research budgets (conservative defaults) ---
MAX_SEARCH_ROUNDS=2
MAX_UNIQUE_SOURCES=20
MAX_CONCURRENT_REQUESTS=4
REQUEST_TIMEOUT_SECONDS=20
MAX_REPORT_WORDS=2500
MAX_RETRY_ATTEMPTS=2
JOB_TIMEOUT_SECONDS=900

# --- Provider circuit breaker ---
PROVIDER_COOLDOWN_SECONDS=60
PROVIDER_QUOTA_COOLDOWN_SECONDS=1800

# --- Uploads ---
MAX_UPLOAD_MB=20
